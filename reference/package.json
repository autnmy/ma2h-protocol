{
  "name": "@ma2h/reference",
  "version": "0.6.0",
  "description": "Vendor-neutral reference implementation and conformance harness for MA2H (the Multi-agent to Human Protocol). Not affiliated with any specific Hub product.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/autnmy/ma2h-protocol.git", "directory": "reference" },
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "node scripts/copy-assets.mjs && tsc -p tsconfig.build.json",
    "ma2h": "node --import tsx bin/ma2h.ts",
    "vectors": "node --import tsx bin/ma2h.ts run-vectors",
    "demo": "node --import tsx demo/playground.ts"
  },
  "bin": { "ma2h": "dist/bin/ma2h.js" },
  "files": ["dist/src", "dist/bin", "schema", "conformance/vectors", "LICENSE", "NOTICE"],
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
