{
  "id": "sv-021-agent-session-bad-shape-invalid",
  "class": "schema-validation",
  "description": "`agent.session` must be a `sess_` id; a run id in that field is rejected.",
  "ref": "spec §4.1 (v0.5), §16",
  "target": "v0.5/message.schema.json",
  "expect": "invalid",
  "input": {
    "ma2h_version": "0.5",
    "type": "notify",
    "created_at": "2026-08-10T12:04:00Z",
    "agent": {
      "id": "overseer/fleet",
      "run_id": "run_01J5OVERSEER01",
      "runtime": "cli",
      "session": "run_01J5OVERSEER01"
    },
    "title": "Session field carries a run id"
  }
}
